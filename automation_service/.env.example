# SERVER ONLY. Store real values in the deployment's secret manager, never Git.
MB_ENV=production
MB_DATABASE_URL=
MB_ENCRYPTION_KEY=
MB_ADMIN_KEY=
MB_BRIDGE_KEY=
MB_PUBLIC_URL=
MB_TRACKER_URL=
MB_BILLING_PORTAL_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Default locked to test mode. Complete the release checklist before live mode.
MB_STRIPE_LIVE=false
MB_RELEASE_REVIEWED=false
MB_BOOKING_ENABLED=false
MB_LEGACY_LINK_ENABLED=false
MB_STRIPE_PRICE_PLANS={}
# Review access-start policy before launch: activation or payment.
MB_PACKAGE_START=activation
MB_BOOKING_LEAD_SECONDS=86400
MB_SMTP_HOST=
MB_SMTP_PORT=587
MB_SMTP_USER=
MB_SMTP_PASSWORD=
MB_MAIL_FROM=
MB_COACH_EMAIL=
# Optional: event-driven email wakeups using an already provisioned Cloud Tasks
# queue. Blank keeps the existing scheduler-only worker. No queue is created.
MB_TASK_QUEUE=
# Returning-student checkout stays closed until real test-mode validation and
# replacement of the unrestricted public monthly Payment Link are complete.
MB_RENEWAL_ENABLED=false
